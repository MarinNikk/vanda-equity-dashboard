# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Your Twelvedata API key (free tier). Used ONLY by the importer, server-side.
TWELVEDATA_API_KEY=your_key_here

# Postgres connection string. The default matches the docker-compose.yml service
# at the repo root (start it with `docker compose up -d`).
DATABASE_URL=postgresql://vanda:vanda@localhost:5432/vanda

# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# Send the session cookie only over HTTPS. Leave false for local http; set to
# true in production (Render sets this). See DEPLOY.md.
COOKIE_SECURE=false
